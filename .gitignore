# generated by the benchmark (regenerate with: python benchmark.py)
data/benchmark/

# generated by the break-point search (regenerate with: python breakpoints.py)
data/breakpoints/

# generated by the test suite (regenerate with: python -m pytest)
data/tests/

# agent harness state and locally installed agent skills
.pi/
.worktrees/
.agents/
