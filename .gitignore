# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# test and lint tooling
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# generated by solve.py and the analysis scripts (regenerate with: python solve.py)
data/*_acquisition.csv
data/*_chips.csv
data/*_attrs.json
*.cu8
# the answer itself is tracked: data/*_joint_flips.csv, data/*_modified_positions.csv,
